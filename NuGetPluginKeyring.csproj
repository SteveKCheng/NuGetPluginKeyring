<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      NuGet 6.13+ discovers plugins on PATH, but only files named "nuget-plugin-*"
      (lowercase prefix, executable bit set).  Naming the output accordingly means a
      single build works for both discovery mechanisms:
        * PATH discovery        -> nuget-plugin-keyring (apphost)
        * ~/.nuget/plugins/netcore/nuget-plugin-keyring/nuget-plugin-keyring.dll
      The convention-based location requires the folder name to match the assembly name.
    -->
    <AssemblyName>nuget-plugin-keyring</AssemblyName>
    <RootNamespace>NuGetPluginKeyring</RootNamespace>

    <!-- Never let anything but the plugin protocol reach stdout. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- test/ holds a standalone end-to-end harness with its own project; keep it out of
       this one's compilation and out of the publish output. -->
  <ItemGroup>
    <Compile Remove="test/**" />
    <None Remove="test/**" />
  </ItemGroup>

</Project>
